# CropLens Agent — Frontend environment
# Copy to .env and set VITE_API_BASE_URL to your deployed backend.
# For local dev with the Vite proxy, leave blank to use the /api proxy -> http://localhost:8080.
VITE_API_BASE_URL=

# Optional Supabase (not required for analysis; reserved for future history persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
